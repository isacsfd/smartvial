# Variables de entorno del puente. NO guardar valores reales en el repositorio.
# En Render se configuran en el panel del servicio (sync: false).

# Entorno: "production" deshabilita /docs y /openapi.json.
ENVIRONMENT=development

# Cadena de conexión de Neon. El puente fuerza TLS (verify-full) por encima de
# lo que traiga la URL; no hace falta añadir sslmode aquí.
NEON_DATABASE_URL=postgresql://USUARIO:CLAVE@HOST/DB

# Token compartido con Apps Script (cabecera X-Bridge-Token).
BRIDGE_TOKEN=cambiar-por-token-largo-y-aleatorio

# TLS de PostgreSQL. verify-full cifra Y valida el certificado del servidor.
# Nunca uses "disable"/"allow"/"prefer": el servidor los eleva a verify-full.
PG_SSLMODE=verify-full
# "certifi" usa el bundle de CA incluido en el wheel (portable en Render);
# "system" usa el almacén del SO; otra ruta se toma como PEM propio.
PG_SSLROOTCERT=certifi

# Límites (opcionales).
MAX_BODY_BYTES=2097152
MAX_ROWS_PER_REQUEST=500
MAX_PAYLOAD_KEYS=200
MAX_VALUE_LENGTH=50000
MAX_ROW_NUMBER=1000000
